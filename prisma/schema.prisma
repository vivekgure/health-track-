// Prisma schema for LifeSync

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  name         String
  avatar       String?
  googleId     String?   @unique
  googleEmail  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile           Profile?
  sleepSessions     SleepSession[]
  activityRecords   ActivityRecord[]
  dailySteps        DailyStep[]
  foodEntries       FoodEntry[]
  waterLogs         WaterLog[]
  screenTimeRecords ScreenTimeRecord[]
  focusSessions     FocusSession[]
  habits            Habit[]
  habitCompletions  HabitCompletion[]
  notifications     Notification[]
}

model Profile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                     Int?     @default(28)
  gender                  String?  @default("not_specified")
  heightCm                Float?   @default(175)
  weightKg                Float?   @default(70)
  activityLevel           String?  @default("moderate") // sedentary, light, moderate, active, very_active
  sleepTargetHours        Float    @default(8.0)
  stepGoal                Int      @default(10000)
  waterGoalMl             Int      @default(2500)
  calorieGoal             Int      @default(2200)
  proteinGoalG            Int      @default(120)
  carbsGoalG              Int      @default(250)
  fatGoalG                Int      @default(65)
  screenTimeLimitMinutes  Int      @default(240) // 4 hours
  themePreference         String   @default("dark")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model SleepSession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
  qualityRating   Int?      // 1 to 5 stars
  sleepConsistency Int?     // score 0 - 100
  notes           String?
  isCompleted     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, startTime])
}

model ActivityRecord {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD
  type            String   // Walking, Running, Cycling, Gym, Yoga, Swimming, etc.
  durationMinutes Int
  distanceKm      Float?   @default(0)
  caloriesBurned  Int
  steps           Int?     @default(0)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([userId, date])
}

model DailyStep {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String   // YYYY-MM-DD
  steps          Int      @default(0)
  goal           Int      @default(10000)
  distanceKm     Float    @default(0)
  caloriesBurned Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
}

model FoodEntry {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String   // YYYY-MM-DD
  mealType    String   // breakfast, lunch, dinner, snack
  foodName    String
  servingSize String?  @default("1 serving")
  calories    Int
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatG        Float    @default(0)
  fiberG      Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  amountMl  Int      // e.g. 250
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model ScreenTimeRecord {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD
  category        String   // Productivity, Social, Entertainment, Utility, Health
  appName         String   // e.g., "Code Editor", "YouTube", "Social Media"
  durationMinutes Int
  isProductive    Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, date])
}

model FocusSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime       DateTime @default(now())
  durationMinutes Int      @default(25)
  tag             String   @default("Deep Work")
  completed       Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([userId])
}

model Habit {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  category          String            @default("wellness") // wellness, productivity, fitness, mindfulness
  targetDaysPerWeek Int               @default(7)
  color             String            @default("#10B981")
  icon              String            @default("CheckCircle")
  reminderTime      String?
  archived          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  completions       HabitCompletion[]

  @@index([userId])
}

model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String   // YYYY-MM-DD
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // info, reminder, success, alert
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

